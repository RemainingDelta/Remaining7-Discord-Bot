# MASTER SWITCH
# Set to 'PROD' -> Uses Main Bot Token & Main Server IDs (Channels/Roles)
# Set to 'DEV' -> Uses Dev Bot Token & Test Server IDs
BOT_MODE=DEV


# The Token for your MAIN (Public) Bot
PROD_TOKEN=insert_real_token_here

# The Token for your DEV (Test) Bot
DEV_TOKEN=insert_test_token_here

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=R7Bot


# Gemini API Key for AI-powered GitHub issue creation (get from aistudio.google.com)
GEMINI_TOKEN=insert_gemini_token_here
# GitHub Personal Access Token with 'repo' scope (generate at GitHub → Settings → Developer Settings)
GITHUB_TOKEN=insert_github_token_here

# Brawl Stars API key (developer.brawlstars.com). The key is IP-allowlisted: list the bot host's public IP when creating it.
BRAWL_STARS_TOKEN=insert_brawl_stars_token_here
# Optional: override the API base URL, e.g. https://bsproxy.royaleapi.dev/v1 for the RoyaleAPI proxy
BRAWL_STARS_API_URL=https://api.brawlstars.com/v1
