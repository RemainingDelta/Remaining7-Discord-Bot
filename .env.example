# MASTER SWITCH
# Set to 'PROD' -> Uses Main Bot Token & Main Server IDs (Channels/Roles)
# Set to 'DEV' -> Uses Dev Bot Token & Test Server IDs
BOT_MODE=DEV


# The Token for your MAIN (Public) Bot
PROD_TOKEN=insert_real_token_here

# The Token for your DEV (Test) Bot
DEV_TOKEN=insert_test_token_here

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=R7Bot